{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/deepseek-v4-flash-free",
  "small_model": "mistral/codestral-latest",
  "provider": {
    "google": {
      "options": {
        "apiKey": "{env:GEMINI_API_KEY_OC}"
      }
    },
    "cerebras": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Cerebras (free tier)",
      "options": {
        "baseURL": "https://api.cerebras.ai/v1",
        "apiKey": "{env:CEREBRAS_API_KEY}"
      },
      "models": {
        "gpt-oss-120b": {
          "name": "GPT-OSS 120B (Cerebras)"
        },
        "zai-glm-4.7": {
          "name": "GLM 4.7 (Cerebras, preview)"
        }
      }
    },
    "groq": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Groq (free tier)",
      "options": {
        "baseURL": "https://api.groq.com/openai/v1",
        "apiKey": "{env:GROQ_API_KEY}"
      },
      "models": {
        "openai/gpt-oss-120b": {
          "name": "GPT-OSS 120B (Groq)"
        },
        "llama-3.3-70b-versatile": {
          "name": "Llama 3.3 70B (Groq)"
        }
      }
    },
    "openrouter-free": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenRouter (:free models)",
      "options": {
        "baseURL": "https://openrouter.ai/api/v1",
        "apiKey": "{env:OPENROUTER_API_KEY}"
      },
      "models": {
        "poolside/laguna-s-2.1:free": {
          "name": "Laguna S 2.1 (coding, free)",
          "limit": {
            "context": 262144,
            "output": 32768
          }
        },
        "cohere/north-mini-code:free": {
          "name": "North Mini Code (free)",
          "limit": {
            "context": 256000,
            "output": 32768
          }
        },
        "nvidia/nemotron-3-ultra-550b-a55b:free": {
          "name": "Nemotron 3 Ultra 550B (free, 1M ctx)",
          "limit": {
            "context": 1000000,
            "output": 32768
          }
        }
      }
    },
    "mistral": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Mistral (free tier)",
      "options": {
        "baseURL": "https://api.mistral.ai/v1",
        "apiKey": "{env:MISTRAL_API_KEY}"
      },
      "models": {
        "codestral-latest": {
          "name": "Codestral (latest) — VERIFIED working 2026-08-02"
        }
      }
    },
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local, offline)",
      "options": {
        "baseURL": "http://localhost:11434/v1",
        "apiKey": "ollama"
      },
      "models": {
        "qwen2.5-coder:7b": {
          "name": "Qwen2.5 Coder 7B (local, 4.7GB)"
        },
        "qwen2.5-coder:3b": {
          "name": "Qwen2.5 Coder 3B (local, 1.9GB)"
        }
      }
    }
  },
  "permission": {
    "edit": "allow",
    "webfetch": "allow",
    "bash": {
      "*": "allow",
      "git push*": "deny",
      "git restore*": "deny",
      "git reset*": "deny",
      "git stash*": "deny",
      "git clean*": "deny",
      "git merge*": "deny",
      "git rebase*": "deny",
      "git checkout main": "deny",
      "git checkout --*": "deny",
      "git switch main": "deny",
      "rm *": "deny",
      "rmdir *": "deny",
      "del *": "deny"
    }
  }
}
