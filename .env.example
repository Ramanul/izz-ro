# Copiază în .env (NU se commitează). Local pentru testarea pipeline-ului AI.
GEMINI_API_KEY=
AI_PROVIDER=gemini
# Optional:
# ANTHROPIC_API_KEY=
# CF_ANALYTICS_TOKEN=        # token Cloudflare Web Analytics (cookieless)
# SITE_BASE=                 # gol pe domeniu propriu (izz.ro); /izz-ro pe GitHub Pages

# Optional multi-provider router. Default remains legacy Gemini + local Ollama fallback.
AI_ROUTER_MODE=legacy
# Comma-separated order used only when AI_ROUTER_MODE=multi.
AI_FALLBACK_PROVIDERS=groq,cerebras,mistral,openrouter,perplexity,upstage
# Optional European fallback; requires explicit endpoint and model.
# AI_FALLBACK_PROVIDERS=groq,mistral,scaleway
# SCALEWAY_API_KEY=
# SCALEWAY_BASE_URL=
# SCALEWAY_MODEL=

# Optional local Claude Code validation. `off` preserves the legacy workflow.
# `report` records a verdict; `required` blocks save/render unless approved.
CLAUDE_CODE_VALIDATE=off
# CLAUDE_CODE_BIN=claude
# CLAUDE_CODE_TIMEOUT=120
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar
UPSTAGE_API_KEY=
UPSTAGE_MODEL=solar-pro
