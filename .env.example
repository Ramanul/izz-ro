# Copiază în .env (NU se commitează). Local pentru testarea pipeline-ului AI.
GEMINI_API_KEY=
AI_PROVIDER=gemini
# Optional:
# ANTHROPIC_API_KEY=
# CF_ANALYTICS_TOKEN=        # token Cloudflare Web Analytics (cookieless)
# SITE_BASE=                 # gol pe domeniu propriu (izz.ro); /izz-ro pe GitHub Pages

# Optional multi-provider router. Default remains legacy Gemini + local Ollama fallback.
AI_ROUTER_MODE=legacy
# Comma-separated order used only when AI_ROUTER_MODE=multi.
AI_FALLBACK_PROVIDERS=groq,cerebras,mistral,openrouter,perplexity,upstage
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar
UPSTAGE_API_KEY=
UPSTAGE_MODEL=solar-pro
