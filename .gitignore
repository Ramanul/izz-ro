.env
output/
# Doua fixturi (test_entities_verified, test_sitemap_editorial) re-randeaza doar cand output/
# lipseste, deci un output/ de pe alta ramura le face sa pice pe cod care nu e cel testat.
# Solutia e sa-l muti deoparte inainte de pytest — iar copia mutata nu are ce cauta in git.
output.stale*/
# Orice alta copie de output/ pusa deoparte pentru comparatie (premerge-check, prev-branch,
# ce mai inventeaza sesiunea urmatoare). Un `git add -A` neatent ar comite un site randat intreg.
output.*/
.audit/
__pycache__/
*.pyc
*.log
data/*.db

# wrangler local cache (contine wrangler-account.json - date de cont)
.wrangler/

# worktrees efemere ale sub-agentilor (unealta, nu continut de proiect)
.claude/worktrees/
# arhiva reconstruita din istoric (tools/arhiva.py) — nu se comite, e duplicare
data/archive/

# coada efemera IndexNow (scrisa de --plan, consumata de --send in aceeasi rulare)
data/.indexnow_queue.json
