# ai_gateway — COPIEZĂ în .env și completează. .env e în .gitignore, nu se comite.
# Nicio cheie reală în repository (spec secțiunea 13).

# ---- gate-ul local ----------------------------------------------------------
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=20129
# OmniRoute local (pornește: omniroute  → http://127.0.0.1:20128)
OMNIROUTE_BASE_URL=http://127.0.0.1:20128
# cheia pe care o pui în clientul de coding (recomandat); gol = fără auth pe localhost
GATEWAY_API_KEY=

# ---- siguranță (NU schimba fără să citești FREE_AI_SETUP.md) ----------------
GLOBAL_FREE_ONLY=true
OPENAI_FREE_ONLY=true
REDACT_SECRETS=true
DRY_RUN=false
ALLOW_CAUTION=false
ALLOW_AUTO=false

# ---- OpenAI complimentary tokens (spec secțiunile 3, 5, 14, 32) -------------
# Pornește LĂSAT PE 0. Când ai verificat în dashboard că oferta e activă și ai
# activat data sharing, setează aici plafoanele OFICIALE ale contului tău, în tokeni:
#   10000000 (10M) / 2500000 (2.5M) pentru grupul mini
#   1000000 (1M)   / 250000 (250K)  pentru grupul mare
OPENAI_COMPLIMENTARY_CONFIRMED=false
OPENAI_LIMIT_GROUP_1M=0
OPENAI_LIMIT_GROUP_10M=0
# marginea internă de siguranță: 0.20 = ne oprim la 80% din plafonul oficial
OPENAI_SAFETY_MARGIN=0.20

# ---- cheile de provider (free) — se creează în consolele respective ----------
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
GITHUB_TOKEN=
ZAI_API_KEY=
CLOUDFLARE_API_TOKEN=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
