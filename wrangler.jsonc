{
  // Workers Static Assets — izz.ro este 100% static, deci NU exista "main":
  // fara script de Worker, assets-only (docs Cloudflare: binding ASSETS e valid
  // doar impreuna cu "main").
  "name": "izz-ro",
  "compatibility_date": "2026-06-18",
  "assets": {
    "directory": "./output",
    // Pages DEDUCEA singur 404.html; Workers NU o face — fara linia asta,
    // orice URL inexistent intoarce un 404 gol si pagina noastra 404.html
    // (output/404.html) nu mai e servita niciodata.
    "not_found_handling": "404-page"
  },
  // Preview per ramura (echivalentul <branch>.izz-ro.pages.dev de la Pages).
  // CLAUDE.md §16.3 se bazeaza pe el ca sa poata confirma "pe live" un fix.
  "preview_urls": true,
  // Origine fara bot challenge, inlocuitorul lui izz-ro.pages.dev. NU e comoditate:
  // zona izz.ro are challenge activ, iar sondele care il primesc citesc pagina de
  // interstitiu ca pe continut -- asta a tinut visual.yml rosu 77 de rulari
  // (17 iul - 5 aug 2026). visual/monitor/harta-smoke/harta-data au nevoie de o
  // origine curata; pe Workers, aceea e subdomeniul workers.dev.
  "workers_dev": true
}
